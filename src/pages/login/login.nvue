  margin-left: 24rpx;
  margin-right: 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.social-row {
  flex-direction: row;
  justify-content: center;
  width: 100%;
  margin-top: 44rpx;
}
.social-btn {
  flex-direction: column;
  align-items: center;
}
.social-gap {
  margin-left: 160rpx;
}
.social-icon {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
}
.icon-wechat-bg {
  background-image: linear-gradient(135deg, #2ee56b 0%, #07c160 100%);
  box-shadow: 0 10rpx 28rpx rgba(7, 193, 96, 0.35);
}
.icon-phone-bg {
  background-image: linear-gradient(135deg, #4f8cff 0%, $brand-purple 100%);
  box-shadow: 0 10rpx 28rpx rgba(96, 116, 255, 0.35);
}
.social-hover {
  transform: scale(0.92);
  opacity: 0.85;
}
.social-label {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
}

/* ---- 微信图标（气泡 + 双眼 + 尾巴，尾巴由伪元素改为真实子元素） ---- */
.wc-bubble {
  position: relative;
  flex-direction: column;
  width: 50rpx;
  height: 40rpx;
  background-color: #ffffff;
  border-radius: 50%;
}
.wc-tail {
  position: absolute;
  left: 7rpx;
  bottom: -5rpx;
  width: 14rpx;
  height: 14rpx;
  background-color: #ffffff;
  border-radius: 3rpx;
  transform: rotate(25deg);
}
.wc-eye {
  position: absolute;
  top: 13rpx;
  width: 7rpx;
  height: 11rpx;
  border-radius: 50%;
  background-color: #07c160;
}
.wc-eye-l {
  left: 14rpx;
}
.wc-eye-r {
  right: 14rpx;
}

/* ---- 手机图标（机身 + 听筒 + 按键，听筒由伪元素改为真实子元素） ---- */
.ph-body {
  position: relative;
  flex-direction: column;
  width: 38rpx;
  height: 54rpx;
  border-width: 4rpx;
  border-style: solid;
  border-color: #ffffff;
  border-radius: 8rpx;
}
.ph-speaker {
  position: absolute;
  top: 6rpx;
  left: 13rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background-color: $white-90;
}
.ph-dot {
  position: absolute;
  bottom: 5rpx;
  left: 15rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: $white-90;
}

/* ---- 协议 ---- */
.agreement {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 30rpx 40rpx;
}
.agree-check {
  flex-direction: row;
  align-items: center;
}
.agree-checkbox {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  border-radius: 10rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.4);
}
.agreement-text {
  flex-direction: row;
  align-items: center;
}
.agree-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}
.agree-link {
  color: $brand-light-purple;
}
</style>
