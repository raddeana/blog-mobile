<template>
  <!-- Feed 卡片骨架：nvue 不支持 @keyframes，呼吸效果由 JS 定时器驱动 opacity -->
  <view class="sk-list">
    <view v-for="n in count" :key="n" class="sk-card">
      <!-- 头部：头像 + 昵称/时间 + 关注按钮 -->
      <view class="sk-header">
        <view class="sk-b sk-avatar" :style="blockStyle(0)" />
        <view class="sk-user">
          <view class="sk-b sk-name" :style="blockStyle(1)" />
          <view class="sk-b sk-time" :style="blockStyle(2)" />
        </view>
        <view class="sk-b sk-follow" :style="blockStyle(3)" />
      </view>
      <!-- 正文：标题 + 摘要 + 封面 + 标签 -->
      <view class="sk-b sk-title" :style="blockStyle(4)" />
      <view class="sk-b sk-excerpt" :style="blockStyle(5)" />
      <view class="sk-b sk-cover" :style="blockStyle(6)" />
      <view class="sk-tags">
        <view class="sk-b sk-tag" :style="blockStyle(7)" />
        <view class="sk-b sk-tag" :style="blockStyle(8)" />
        <view class="sk-b sk-tag" :style="blockStyle(9)" />
      </view>
      <!-- 互动栏 -->
      <view class="sk-actions">
        <view v-for="i in 3" :key="i" class="sk-action">
          <view class="sk-b sk-action-ic" :style="blockStyle(9 + i * 2)" />
          <view class="sk-b sk-action-txt" :style="blockStyle(10 + i * 2)" />
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, onBeforeUnmount } from 'vue'

withDefaults(defineProps<{ count?: number }>(), { count: 4 })

/* ---- 呼吸动画：奇偶块交替明暗，850ms 翻转一次 ---- */
const pulse = ref(false)
let timer: ReturnType<typeof setInterval> | null = null

onMounted(() => {
  timer = setInterval(() => {
    pulse.value = !pulse.value
  }, 850)
})

onBeforeUnmount(() => {
  if (timer) clearInterval(timer)
})

function blockStyle(i: number) {
  const bright = (i % 2 === 0) === pulse.value
  return { opacity: bright ? 1 : 0.4 }
}
</script>

<style lang="scss">
.sk-list {
  flex-direction: column;
}

/* ---- 卡片（与 FeedCard 同尺寸） ---- */
.sk-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  padding-top: 32rpx;
  padding-bottom: 32rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  flex-direction: column;
}

/* ---- 呼吸块基础类（transition 在 H5/小程序平滑，weex 不支持时自动降级为阶跃） ---- */
.sk-b {
  background-color: #ececf0;
  border-radius: 8rpx;
  transition-property: opacity;
  transition-duration: 700ms;
  transition-timing-function: ease-in-out;
}

/* ---- 头部 ---- */
.sk-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
}
.sk-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
}
.sk-user {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}
.sk-name {
  width: 200rpx;
  height: 26rpx;
  margin-bottom: 12rpx;
}
.sk-time {
  width: 130rpx;
  height: 22rpx;
}
.sk-follow {
  width: 100rpx;
  height: 44rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
}

/* ---- 正文 ---- */
.sk-title {
  width: 480rpx;
  height: 32rpx;
  margin-bottom: 16rpx;
}
.sk-excerpt {
  width: 360rpx;
  height: 26rpx;
  margin-bottom: 24rpx;
}
.sk-cover {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.sk-tags {
  display: flex;
  flex-direction: row;
}
.sk-tag {
  width: 90rpx;
  height: 36rpx;
  border-radius: 18rpx;
  margin-right: 20rpx;
}

/* ---- 互动栏（与 FeedCard action-bar 对齐） ---- */
.sk-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top-width: 1rpx;
  border-top-style: solid;
  border-top-color: rgba(0, 0, 0, 0.04);
}
.sk-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx;
}
.sk-action-ic {
  width: 36rpx;
  height: 32rpx;
  border-radius: 8rpx;
}
.sk-action-txt {
  width: 60rpx;
  height: 22rpx;
  margin-left: 10rpx;
}
</style>
