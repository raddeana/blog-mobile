  width: 24rpx;
  height: 13rpx;
  margin-top: 3rpx;
  border-top-left-radius: 12rpx;
  border-top-right-radius: 12rpx;
  border-bottom-left-radius: 5rpx;
  border-bottom-right-radius: 5rpx;
  background-color: #ffffff;
}

