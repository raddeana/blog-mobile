<template>
  <view class="page" :style="pageStyle">
    <beautiful-background />

    <!-- 返回登录（fixed 定位，top 由状态栏高度 + JS 计算） -->
    <view
      class="back-btn"
      hover-class="back-hover"
      :hover-stay-time="80"
      :style="{ top: statusBarHeight + 10 + 'px' }"
      @tap="goLogin"
    >
      <view class="back-arrow" />
    </view>

    <scroll-view class="body-scroll" scroll-y :style="{ flex: 1 }">
      <view class="content">
        <!-- 默认头像 -->
        <view class="logo-wrap">
          <view class="avatar-default">
            <view class="avatar-head" />
            <view class="avatar-body" />
          </view>
        </view>

        <text class="title">创建账号</text>
        <text class="subtitle">加入博客单，遇见更多精彩</text>

        <!-- 表单卡片 -->
        <view class="card">
          <!-- 用户名 -->
          <beautiful-input v-model="form.username" type="text" icon="user" placeholder="请输入用户名（3-20 字符）" />
          <!-- 昵称 -->
          <beautiful-input v-model="form.nickname" type="text" icon="smile" placeholder="请输入昵称" />
          <!-- 密码 -->
          <beautiful-input v-model="form.password" type="password" icon="lock" placeholder="请输入密码（至少 6 位）" />
          <!-- 确认密码 -->
          <beautiful-input v-model="form.confirmPassword" type="password" icon="shield" placeholder="请再次输入密码" />
          <!-- 邮箱 -->
          <beautiful-input v-model="form.email" type="text" icon="mail" placeholder="请输入邮箱" />
          <!-- 协议 -->
          <view class="agreement">
            <view class="agree-check" @tap="agree = !agree">
              <view class="agree-checkbox" :style="agree ? checkedStyle : {}">
                <text v-if="agree" class="agree-mark">✓</text>
              </view>
            </view>
            <view class="agreement-text">
              <text class="agree-text">我已阅读并同意</text>
              <text class="agree-text agree-link">《用户协议》</text>
              <text class="agree-text">和</text>
              <text class="agree-text agree-link">《隐私政策》</text>
            </view>
          </view>

          <!-- 注册按钮 -->
          <beautiful-button @tap="onRegister">
            <template #text><text class="btn-text btn-text-reg">注册</text></template>
          </beautiful-button>
        </view>

        <!-- 去登录 -->
        <view class="login-row">
          <text class="gray-text">已有账号？</text>
          <text class="link login-link" @tap="goLogin">去登录</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { reactive, ref } from 'vue'

// 组件（nvue 页面引用同名 nvue 组件，import 不带扩展名）
import BeautifulBackground from '@/components/BeautifulBackground';
import BeautifulButton from '@/components/BeautifulButton';
import BeautifulInput from '@/components/BeautifulInput';

// 状态栏：原 CSS 状态栏变量改为 JS 计算（back-btn 的 top / 根节点 paddingTop）
const sys = uni.getSystemInfoSync()
const statusBarHeight = sys.statusBarHeight || 0

const pageStyle = { paddingTop: statusBarHeight + 'px' }
// 勾选态（nvue 无复合状态选择器，改为内联样式切换）
const checkedStyle = {
  backgroundImage: 'linear-gradient(135deg, #7b5cff, #ff5c9d)',
  borderColor: 'rgba(0, 0, 0, 0)'
}

const form = reactive({
  username: '',
  nickname: '',
  password: '',
  confirmPassword: '',
  email: ''
})

const agree = ref(false)
const loading = ref(false)

function toast(title: string) {
  uni.showToast({ title, icon: 'none' })
}

function onRegister() {
  const username = form.username.trim()
  const nickname = form.nickname.trim()
  const email = form.email.trim()
  if (!username) return toast('请输入用户名')
  if (username.length < 3) return toast('用户名至少 3 个字符')
  if (!nickname) return toast('请输入昵称')
  if (!form.password) return toast('请输入密码')
  if (form.password.length < 6) return toast('密码至少 6 位')
  if (form.confirmPassword !== form.password) return toast('两次输入的密码不一致')
  if (!email) return toast('请输入邮箱')
  if (!/^[\w.%+-]+@[\w-]+(\.[\w-]+)+$/.test(email)) return toast('邮箱格式不正确')
  if (!agree.value) return toast('请先阅读并同意相关协议')

  loading.value = true
  uni.showLoading({ title: '注册中...' })
  // TODO: 替换为真实注册接口
  setTimeout(() => {
    uni.hideLoading()
    loading.value = false
    uni.showToast({ title: '注册成功', icon: 'success' })
    setTimeout(() => {
      uni.navigateBack({
        fail: () => uni.reLaunch({ url: '/pages/login/login' })
      })
    }, 1200)
  }, 1200)
}

function goLogin() {
  uni.navigateBack({
    fail: () => uni.reLaunch({ url: '/pages/login/login' })
  })
}
</script>

<style lang="scss">
/* nvue 样式全局生效；状态栏高度由 pageStyle / back-btn 内联样式注入 */
.page {
  flex: 1;
  flex-direction: column;
  background-color: #1a103a;
  background-image: $page-bg-gradient;
}
.body-scroll {
  flex: 1;
}

/* ---- 返回按钮 ---- */
.back-btn {
  position: fixed;
  left: 30rpx;
  z-index: 10;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.08);
  border-width: 1rpx;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.15);
}
.back-hover {
  background-color: rgba(255, 255, 255, 0.16);
  transform: scale(0.92);
}
.back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left-width: 4rpx;
  border-left-style: solid;
  border-left-color: $white-90;
  border-bottom-width: 4rpx;
  border-bottom-style: solid;
  border-bottom-color: $white-90;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

/* ---- 内容区 ---- */
.content {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 64rpx 30rpx;
}

/* ---- 默认头像 ---- */
.logo-wrap {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  padding: 6rpx;
  margin-top: 40rpx;
  flex-direction: column;
  background-image: linear-gradient(135deg, $brand-purple, $brand-pink);
  box-shadow: 0 12rpx 48rpx rgba($brand-purple, 0.55);
}
.avatar-default {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-image: $avatar-gradient;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  overflow: hidden;
}
.avatar-head {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.96);
}
.avatar-body {
  width: 116rpx;
  height: 50rpx;
  margin-top: 8rpx;
  border-top-left-radius: 58rpx;
  border-top-right-radius: 58rpx;
  background-color: rgba(255, 255, 255, 0.96);
}

.title {
  margin-top: 36rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
  /* 原渐变文字（背景裁切到文字）nvue 不支持，改为纯色 */
}
.subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 2rpx;
}

/* ---- 表单卡片 ---- */
.card {
  width: 100%;
  margin-top: 48rpx;
  padding: 48rpx 40rpx;
  border-radius: 40rpx;
  background-color: rgba(255, 255, 255, 0.07);
  border-width: 1rpx;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.12);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.35);
}

/* ---- 协议 ---- */
.agreement {
  flex-direction: row;
  align-items: center;
  margin: 8rpx 0 32rpx;
}
.agree-check {
  flex-direction: row;
  align-items: center;
  padding: 14rpx;
  margin-left: -14rpx;
}
.agree-checkbox {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 8rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.35);
}
.agree-mark {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 700;
}
.agreement-text {
  flex-direction: row;
  align-items: center;
  margin-left: 6rpx;
}
.agree-text {
  font-size: 24rpx;
  color: $white-50;
}
.agree-link {
  color: $brand-light-purple;
}

/* ---- 注册按钮文字（覆盖组件默认字距） ---- */
.btn-text-reg {
  letter-spacing: 6rpx;
  font-weight: 700;
}

/* ---- 去登录 ---- */
.login-row {
  flex-direction: row;
  align-items: center;
  margin-top: 36rpx;
}
.login-link {
  font-weight: 600;
  padding: 10rpx;
}
.link {
  font-size: 26rpx;
  color: $brand-light-purple;
}
.gray-text {
  font-size: 26rpx;
  color: $white-50;
}
</style>
