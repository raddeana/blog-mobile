}

/* ---- 自我描述 ---- */
.bio-head {
  width: 100%;
  flex-direction: row;
  align-items: center;
}
.bio-count {
  font-size: 24rpx;
  color: #b0b0b8;
}
.bio-input {
  width: 100%;
  height: 160rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 40rpx;
}

/* ---- 保存按钮（品牌渐变） ---- */
.save-btn {
  margin-top: 48rpx;
  margin-left: 24rpx;
  margin-right: 24rpx;
  height: 92rpx;
  border-radius: 46rpx;
  background-image: linear-gradient(90deg, #7b5cff 0%, #b750ff 50%, #ff5c9d 100%);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(123, 92, 255, 0.35);
}
.save-hover {
  opacity: 0.85;
}
.save-btn-disabled {
  opacity: 0.5;
}
.save-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
}
</style>
