<template>
  <view class="page" :style="pageStyle">
    <beautiful-background />

    <!-- 返回登录（fixed 定位，top 由状态栏高度 + JS 计算） -->
    <view
      class="back-btn"
      hover-class="back-hover"
      :hover-stay-time="80"
      :style="{ top: statusBarHeight + 10 + 'px' }"
      @tap="goBack"
    >
      <view class="back-arrow" />
    </view>

    <scroll-view class="body-scroll" scroll-y :style="{ flex: 1 }">
      <view class="content">
        <!-- 默认头像 -->
        <view class="logo-wrap">
          <view class="avatar-default">
            <view class="avatar-head" />
            <view class="avatar-body" />
          </view>
        </view>

        <text class="title">找回密码</text>
        <text class="subtitle">通过邮箱验证码重置密码</text>

        <!-- 步骤指示器（激活/完成态由内联样式切换） -->
        <view class="steps">
          <view class="step-dot" :style="dotStyle(1)">
            <view class="step-inner" :style="innerStyle(1)" />
          </view>
          <view class="step-line" :style="lineStyle(1)" />
          <view class="step-dot" :style="dotStyle(2)">
            <view class="step-inner" :style="innerStyle(2)" />
          </view>
          <view class="step-line" :style="lineStyle(2)" />
          <view class="step-dot" :style="dotStyle(3)">
            <view class="step-inner" :style="innerStyle(3)" />
          </view>
        </view>
        <view class="step-labels">
          <text class="step-label" :style="labelStyle(1)">验证邮箱</text>
          <text class="step-label" :style="labelStyle(2)">输入验证码</text>
          <text class="step-label" :style="labelStyle(3)">设置密码</text>
        </view>

        <!-- 表单卡片 -->
        <view class="card">
          <!-- Step 1：输入邮箱 + 发送验证码 -->
          <template v-if="step === 1">
            <beautiful-input v-model="form.email" type="text" icon="mail" placeholder="请输入注册邮箱" />
            <beautiful-button @tap="sendCode">
              <template #text><text class="btn-text">发送验证码</text></template>
            </beautiful-button>
          </template>

          <!-- Step 2：输入验证码 -->
          <template v-if="step === 2">
            <!-- 验证码行：图标 + 输入 + 发送按钮（带倒计时），样式复用 BeautifulInput 的全局类 -->
            <view class="input-row" :style="codeFocused ? rowFocusedStyle : {}">
              <view class="icon-badge">
                <view class="ic-key">
                  <view class="key-ring" />
                  <view class="key-shaft" />
                  <view class="key-tooth" />
                </view>
              </view>
              <input
                v-model="form.code"
                class="input"
                type="number"
                maxlength="6"
                placeholder="请输入 6 位验证码"
                placeholder-style="color: rgba(255,255,255,0.35)"
                @focus="codeFocused = true"
                @blur="codeFocused = false"
              />
              <view
                class="send-btn"
                :style="countdown > 0 ? sendDisabledStyle : {}"
                hover-class="send-hover"
                :hover-stay-time="80"
                @tap="resendCode"
              >
                <text class="send-text" lines="1">{{ countdown > 0 ? countdown + 's' : '重新发送' }}</text>
              </view>
            </view>

            <beautiful-button @tap="verifyCode">
              <template #text><text class="btn-text">下一步</text></template>
            </beautiful-button>
          </template>

          <!-- Step 3：设置新密码 -->
          <template v-if="step === 3">
            <beautiful-input v-model="form.password" type="password" icon="lock" placeholder="请输入新密码（至少 6 位）" />
            <beautiful-input v-model="form.confirmPassword" type="password" icon="shield" placeholder="请再次输入新密码" />
            <beautiful-button @tap="resetPassword">
              <template #text><text class="btn-text">重置密码</text></template>
            </beautiful-button>
          </template>
        </view>

        <!-- 返回登录 -->
        <view class="login-row">
          <text class="gray-text">记起密码？</text>
          <text class="link login-link" @tap="goBack">返回登录</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { reactive, ref, onUnmounted } from 'vue'

// 组件（nvue 页面引用同名 nvue 组件，import 不带扩展名）
import BeautifulBackground from '@/components/BeautifulBackground';
import BeautifulButton from '@/components/BeautifulButton';
import BeautifulInput from '@/components/BeautifulInput';

// 状态栏：原 CSS 状态栏变量改为 JS 计算（back-btn 的 top / 根节点 paddingTop）
const sys = uni.getSystemInfoSync()
const statusBarHeight = sys.statusBarHeight || 0

const pageStyle = { paddingTop: statusBarHeight + 'px' }

const step = ref(1)
const countdown = ref(0)
// 验证码输入行聚焦态（复用 BeautifulInput 全局样式，聚焦改为静态变色）
const codeFocused = ref(false)
const rowFocusedStyle = {
  borderColor: 'rgba(167, 110, 255, 0.9)',
  backgroundColor: 'rgba(255, 255, 255, 0.12)'
}
// 发送按钮倒计时禁用态（内联样式切换）
const sendDisabledStyle = {
  opacity: 0.5,
  backgroundColor: 'rgba(255, 255, 255, 0.08)',
  borderColor: 'rgba(255, 255, 255, 0.15)'
}
let timer: ReturnType<typeof setInterval> | null = null

const form = reactive({
  email: '',
  code: '',
  password: '',
  confirmPassword: ''
})

/* ---- 步骤指示器状态样式（原复合选择器改为内联样式） ---- */
function dotStyle(n: number) {
  const done = step.value > n
  const active = step.value >= n
  if (done) {
    return {
      backgroundColor: 'rgba(123, 92, 255, 0.6)',
      borderColor: 'rgba(0, 0, 0, 0)',
      boxShadow: '0 6rpx 18rpx rgba(123, 92, 255, 0.4)'
    }
  }
  if (active) {
    return {
      backgroundImage: 'linear-gradient(90deg, #7b5cff, #b750ff, #ff5c9d)',
      borderColor: 'rgba(0, 0, 0, 0)',
      boxShadow: '0 6rpx 18rpx rgba(123, 92, 255, 0.4)'
    }
  }
  return {}
}
function innerStyle(n: number) {
  return { opacity: step.value >= n ? 1 : 0.5 }
}
function lineStyle(n: number) {
  return step.value > n
    ? { backgroundImage: 'linear-gradient(90deg, #7b5cff, #ff5c9d)' }
    : {}
}
function labelStyle(n: number) {
  return step.value === n
    ? { color: '#b28bff', fontWeight: '600' }
    : {}
}

function toast(title: string) {
  uni.showToast({ title, icon: 'none' })
}

/* ---- 倒计时 ---- */
function startCountdown() {
  countdown.value = 60
  if (timer) clearInterval(timer)
  timer = setInterval(() => {
    countdown.value--
    if (countdown.value <= 0) {
      if (timer) { clearInterval(timer); timer = null }
    }
  }, 1000)
}

onUnmounted(() => {
  if (timer) clearInterval(timer)
})

/* ---- Step 1：发送验证码 ---- */
function sendCode() {
  const email = form.email.trim()
  if (!email) return toast('请输入邮箱')
  if (!/^[\w.%+-]+@[\w-]+(\.[\w-]+)+$/.test(email)) return toast('邮箱格式不正确')

  uni.showLoading({ title: '发送中...', mask: true })
  // TODO: 替换为真实发送验证码接口
  setTimeout(() => {
    uni.hideLoading()
    startCountdown()
    step.value = 2
    uni.showToast({ title: '验证码已发送', icon: 'none' })
  }, 1000)
}

/* ---- Step 2：重新发送 ---- */
function resendCode() {
  if (countdown.value > 0) return
  const email = form.email.trim()
  if (!email) return toast('请输入邮箱')

  uni.showLoading({ title: '发送中...', mask: true })
  // TODO: 替换为真实重发接口
  setTimeout(() => {
    uni.hideLoading()
    startCountdown()
    uni.showToast({ title: '验证码已重新发送', icon: 'none' })
  }, 1000)
}

/* ---- Step 2：验证验证码 ---- */
function verifyCode() {
  if (!form.code.trim()) return toast('请输入验证码')
  if (form.code.trim().length !== 6) return toast('验证码为 6 位数字')

  uni.showLoading({ title: '验证中...', mask: true })
  // TODO: 替换为真实验证码校验接口
  setTimeout(() => {
    uni.hideLoading()
    step.value = 3
    uni.showToast({ title: '验证成功', icon: 'none' })
  }, 1000)
}

/* ---- Step 3：重置密码 ---- */
function resetPassword() {
  if (!form.password) return toast('请输入新密码')
  if (form.password.length < 6) return toast('密码至少 6 位')
  if (form.confirmPassword !== form.password) return toast('两次输入的密码不一致')

  uni.showLoading({ title: '重置中...', mask: true })
  // TODO: 替换为真实重置密码接口
  setTimeout(() => {
    uni.hideLoading()
    uni.showToast({ title: '密码重置成功', icon: 'success' })
    setTimeout(() => {
      goBack()
    }, 1200)
  }, 1000)
}

/* ---- 返回 ---- */
function goBack() {
  uni.navigateBack({
    fail: () => uni.reLaunch({ url: '/pages/login/login' })
  })
}
</script>

<style lang="scss">
/* nvue 样式全局生效；验证码输入行复用 BeautifulInput.nvue 的全局类（input-row/icon-badge/ic-key/input） */
.page {
  flex: 1;
  flex-direction: column;
  background-color: #1a103a;
  background-image: $page-bg-gradient;
}
.body-scroll {
  flex: 1;
}

/* ---- 返回按钮 ---- */
.back-btn {
  position: fixed;
  left: 30rpx;
  z-index: 10;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.08);
  border-width: 1rpx;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.15);
}
.back-hover {
  background-color: rgba(255, 255, 255, 0.16);
  transform: scale(0.92);
}
.back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left-width: 4rpx;
  border-left-style: solid;
  border-left-color: $white-90;
  border-bottom-width: 4rpx;
  border-bottom-style: solid;
  border-bottom-color: $white-90;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

/* ---- 内容区 ---- */
.content {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 64rpx 30rpx;
}

/* ---- 默认头像 ---- */
.logo-wrap {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  padding: 6rpx;
  margin-top: 40rpx;
  flex-direction: column;
  background-image: linear-gradient(135deg, $brand-purple, $brand-pink);
  box-shadow: 0 12rpx 48rpx rgba($brand-purple, 0.55);
}
.avatar-default {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-image: $avatar-gradient;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  overflow: hidden;
}
.avatar-head {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.96);
}
.avatar-body {
  width: 116rpx;
  height: 50rpx;
  margin-top: 8rpx;
  border-top-left-radius: 58rpx;
  border-top-right-radius: 58rpx;
  background-color: rgba(255, 255, 255, 0.96);
}

.title {
  margin-top: 36rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
  /* 原渐变文字（背景裁切到文字）nvue 不支持，改为纯色 */
}
.subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 2rpx;
}

/* ---- 步骤指示器 ---- */
.steps {
  flex-direction: row;
  align-items: center;
  margin-top: 40rpx;
}
.step-dot {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.12);
  border-width: 2rpx;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.25);
}
.step-inner {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #ffffff;
}
.step-line {
  width: 60rpx;
  height: 2rpx;
  background-color: rgba(255, 255, 255, 0.2);
}
.step-labels {
  flex-direction: row;
  margin-top: 16rpx;
}
.step-label {
  width: 120rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* ---- 表单卡片 ---- */
.card {
  width: 100%;
  margin-top: 40rpx;
  padding: 48rpx 40rpx;
  border-radius: 40rpx;
  background-color: rgba(255, 255, 255, 0.07);
  border-width: 1rpx;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.12);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.35);
}

/* ---- 验证码发送按钮 ---- */
.send-btn {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0 20rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-image: linear-gradient(135deg, rgba($brand-purple, 0.35), rgba($brand-pink, 0.25));
  border-width: 1rpx;
  border-style: solid;
  border-color: rgba($brand-purple, 0.4);
}
.send-hover {
  transform: scale(0.95);
  opacity: 0.85;
}
.send-text {
  font-size: 22rpx;
  color: $brand-light-purple;
  text-overflow: ellipsis;
}

/* ---- 返回登录 ---- */
.login-row {
  flex-direction: row;
  align-items: center;
  margin-top: 36rpx;
}
.login-link {
  font-weight: 600;
  padding: 10rpx;
}
.link {
  font-size: 26rpx;
  color: $brand-light-purple;
}
.gray-text {
  font-size: 26rpx;
  color: $white-50;
}
</style>
