<template>
  <view class="page" :style="pageStyle">
    <!-- 顶部导航栏 -->
    <view class="topbar">
      <view class="topbar-inner" :style="{ paddingTop: statusBarHeight + 8 + 'px' }">
        <!-- 返回按钮 -->
        <view class="back-btn" hover-class="back-hover" :hover-stay-time="80" @click="onBack">
          <view class="back-arrow" />
        </view>
        <!-- 搜索输入框 -->
        <view class="search-input-wrap">
          <view class="ic-search">
            <view class="search-circle" />
            <view class="search-handle" />
          </view>
          <input
            v-model="keyword"
            class="search-input"
            type="text"
            placeholder="搜索文章、话题、用户"
            placeholder-style="color: #bbb"
            confirm-type="search"
            @confirm="doSearch"
            :focus="autoFocus"
          />
        </view>
        <!-- 搜索按钮 -->
        <view class="search-btn" hover-class="search-hover" :hover-stay-time="80" @click="doSearch">
          <text class="search-btn-text">搜索</text>
        </view>
      </view>
    </view>

    <!-- 内容区 -->
    <scroll-view
      scroll-y
      class="body-scroll"
      :style="{ flex: 1 }"
      :refresher-enabled="true"
      :refresher-triggered="refreshing"
      @refresherrefresh="onRefresh"
      @scrolltolower="onLoadMore"
    >
      <view class="content" :style="{ paddingTop: (statusBarHeight + 44) + 'px' }">
        <!-- 搜索前：历史 + 热搜 -->
        <template v-if="!hasSearched">
          <!-- 搜索历史 -->
          <view v-if="history.length > 0" class="section">
            <view class="section-header">
              <text class="section-title">搜索历史</text>
              <view class="clear-btn" hover-class="clear-hover" :hover-stay-time="80" @click="onClearHistory">
                <text class="clear-text">清空</text>
              </view>
            </view>
            <view class="tag-list">
              <view
                v-for="item in history"
                :key="item"
                class="history-tag"
                hover-class="tag-hover"
                :hover-stay-time="80"
                @click="onTapTag(item)"
              >
                <text class="history-tag-text">{{ item }}</text>
              </view>
            </view>
          </view>

          <!-- 热门搜索 -->
          <view class="section">
            <text class="section-title">热门搜索</text>
            <view class="hot-list">
              <!-- 热搜加载占位（首帧直接渲染，避免标题先出现、列表再冒出） -->
              <template v-if="booting">
                <view v-for="n in 5" :key="'sk' + n" class="hot-item">
                  <view class="hot-sk hot-sk-num" />
                  <view class="hot-sk hot-sk-text" :class="{ 'hot-sk-text-short': n === 4 || n === 5 }" />
                </view>
              </template>
              <template v-else>
                <view
                  v-for="(item, idx) in hotKeywords"
                  :key="item"
                  class="hot-item"
                  hover-class="hot-hover"
                  :hover-stay-time="80"
                  @click="onTapTag(item)"
                >
                  <text class="hot-num" :class="{ 'hot-num-top': idx < 3 }">{{ idx + 1 }}</text>
                  <text class="hot-text">{{ item }}</text>
                </view>
              </template>
            </view>
          </view>
        </template>

        <!-- 搜索后：结果列表 -->
        <template v-else>
          <!-- 初始加载骨架屏 -->
          <FeedSkeleton v-if="loading && resultList.length === 0" :count="3" />

          <!-- 空结果 -->
          <view v-else-if="!loading && resultList.length === 0" class="empty-state">
            <view class="empty-icon">
              <view class="empty-circle" />
              <view class="empty-bar" />
            </view>
            <text class="empty-text">未找到 "{{ searchedKeyword }}" 相关内容</text>
          </view>

          <!-- 结果列表 -->
          <template v-else>
            <view class="result-count">
              <text class="result-count-text">找到 {{ totalFound }} 条结果</text>
            </view>
            <FeedCard
              v-for="item in resultList"
              :key="item.id"
              :item="item"
              @card-tap="onCardTap"
              @like="onLike"
              @comment="onComment"
              @share="onShare"
              @follow="onFollow"
              @vote="onVote"
            />
            <!-- 加载更多 -->
            <view v-if="loading" class="load-more">
              <view class="loading-dots">
                <view class="dot dot-small" />
                <view class="dot dot-small" />
                <view class="dot dot-small" />
              </view>
              <text class="load-more-text">加载更多...</text>
            </view>
            <view v-else-if="!hasMore" class="load-more">
              <text class="load-more-text">没有更多了</text>
            </view>
          </template>
        </template>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref, reactive } from 'vue'
import { searchFeed, getHotKeywords, getSearchHistory, addSearchHistory, clearSearchHistory } from '@/api/search'
import type { FeedItem } from '@/api/feed'
import FeedCard from '@/components/FeedCard.nvue'
import FeedSkeleton from '@/components/FeedSkeleton.nvue'

const sys = uni.getSystemInfoSync()
const statusBarHeight = sys.statusBarHeight || 0
const pageStyle = {}

const keyword = ref('')
const searchedKeyword = ref('')
const hasSearched = ref(false)
const autoFocus = ref(true)
const resultList = ref<FeedItem[]>([])
const loading = ref(false)
const hasMore = ref(true)
const refreshing = ref(false)
const totalFound = ref(0)
const page = reactive({ page: 1, pageSize: 5 })
const history = ref<string[]>([])
const hotKeywords = ref<string[]>([])
// 热搜首屏加载标志：true 期间渲染占位行
const booting = ref(true)

/* ---- 初始化 ---- */
async function init() {
  history.value = getSearchHistory()
  hotKeywords.value = await getHotKeywords()
  booting.value = false
}
init()

/* ---- 执行搜索 ---- */
async function doSearch() {
  const kw = keyword.value.trim()
  if (!kw) {
    uni.showToast({ title: '请输入搜索内容', icon: 'none' })
    return
  }
  hasSearched.value = true
  searchedKeyword.value = kw
  page.page = 1
  hasMore.value = true
  addSearchHistory(kw)
  history.value = getSearchHistory()

  loading.value = true
  const result = await searchFeed({ keyword: kw, page: page.page, pageSize: page.pageSize })
  resultList.value = result.list
  totalFound.value = result.list.length
  hasMore.value = result.hasMore
  page.page++
  loading.value = false
}

/* ---- 下拉刷新 ---- */
async function onRefresh() {
  refreshing.value = true
  if (hasSearched.value) {
    keyword.value = searchedKeyword.value
    await doSearch()
  } else {
    await init()
  }
  refreshing.value = false
}

/* ---- 上拉加载更多 ---- */
function onLoadMore() {
  if (!hasSearched.value || !hasMore.value || loading.value) return
  loadMore()
}

async function loadMore() {
  loading.value = true
  const result = await searchFeed({ keyword: searchedKeyword.value, page: page.page, pageSize: page.pageSize })
  resultList.value.push(...result.list)
  hasMore.value = result.hasMore
  page.page++
  loading.value = false
}

/* ---- 点击标签搜索 ---- */
function onTapTag(text: string) {
  keyword.value = text
  doSearch()
}

/* ---- 清空历史 ---- */
function onClearHistory() {
  uni.showModal({
    title: '清空搜索历史',
    content: '确定清空所有搜索历史吗？',
    success: (res) => {
      if (res.confirm) {
        clearSearchHistory()
        history.value = []
      }
    },
  })
}

/* ---- 返回 ---- */
function onBack() {
  uni.navigateBack({ delta: 1 })
}

/* ---- 互动事件 ---- */
function onLike(item: FeedItem) {
  item.liked = !item.liked
}

function onComment(item: FeedItem) {
  uni.navigateTo({ url: '/pages/comment/comment?id=' + item.id })
}

function onCardTap(item: FeedItem) {
  uni.navigateTo({ url: '/pages/detail/detail?id=' + item.id })
}

function onShare(item: FeedItem) {
  uni.showToast({ title: '转发功能开发中', icon: 'none' })
}

function onFollow(id: number) {
  uni.showToast({ title: '关注成功', icon: 'none' })
}

function onVote(pollId: number, optionId: number) {
  // 预留投票接口
}
</script>

