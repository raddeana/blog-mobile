<template>
    <!-- 背景组件根容器：绝对定位铺满页面，置于内容层之下（nvue 组件需单根节点） -->
    <view class="bg-root">
        <!-- 背景光斑（原浮动动画已删除，改为静态定位；radial 柔光用 linear-gradient 近似） -->
        <view class="orb orb-1" />
        <view class="orb orb-2" />
        <view class="orb orb-3" />
        <!-- 星星点缀（原闪烁动画已删除，改为静态圆点） -->
        <view
            v-for="(s, i) in stars"
            :key="i"
            class="star"
            :style="{
                top: s.top,
                left: s.left,
                width: s.size + 'px',
                height: s.size + 'px'
            }"
        />
    </view>
</template>

<script setup lang="ts">
